<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:p="http://www.springframework.org/schema/p">
  <bean id="ftpClient" class="com.example.shop.FtpClient">
    <constructor-arg name="password" value="dev-only-fake-ctor-password"/>
  </bean>
  <bean id="ldapClient" class="com.example.shop.LdapClient">
    <constructor-arg name="password">
      <value>dev-only-fake-ctor-value-password</value>
    </constructor-arg>
    <property name="managerPassword" value="dev-only-fake-manager-password"/>
    <property name="passwordEncoder" value="bcrypt"/>
    <property name="dbPassword" value="#{systemProperties['db.password']}"/>
  </bean>
  <bean id="workerPool" class="org.springframework.scheduling.concurrent.ThreadPoolTaskExecutor">
    <property name="user" value="batch"/>
    <property name="url" value="https://queue.example.invalid/jobs"/>
  </bean>
  <bean id="boneConfig" class="com.jolbox.bonecp.BoneCPConfig">
    <property name="jdbcUrl" value="jdbc:mysql://bone.example.invalid:3306/shop"/>
    <property name="username" value="bone_app"/>
  </bean>
  <bean id="ldapPool" class="com.example.shop.LdapPool" p:managerPassword="dev-only-fake-p-manager-password" p:adminPasswd='dev-only-fake-p-admin-passwd'/>
  <bean id="mailer" class="com.example.shop.Mailer" p:passwordEncoder="bcrypt" p:dbPassword="#{systemProperties['db.password']}" p:smtpPassword=""/>
  <bean id="reportSource" class="com.example.shop.ReportSource"
        p:filter="a > b" p:dbPassword="dev-only-fake-p-db-password"/>
  <property name="note" p:dbPassword="dev-only-not-a-bean"/>
</beans>
