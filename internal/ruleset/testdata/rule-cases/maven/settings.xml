<?xml version="1.0" encoding="UTF-8"?>
<settings>
  <servers>
    <server>
      <id>example-releases</id>
      <username>dev-only-nexus-user</username>
      <password>dev-only-fake-releases-password</password>
    </server>
    <server>
      <id>example-snapshots</id>
      <username>${env.NEXUS_USER}</username>
      <password>${env.NEXUS_PASSWORD}</password>
    </server>
  </servers>
  <proxies>
    <proxy>
      <id>example-proxy</id>
      <active>true</active>
      <protocol>http</protocol>
      <host>proxy.example.invalid</host>
      <port>8080</port>
      <username>dev-only-proxy-user</username>
      <password>dev-only-fake-proxy-password</password>
    </proxy>
    <proxy>
      <id>example-proxy-env</id>
      <username>${env.PROXY_USER}</username>
      <password>${env.PROXY_PASSWORD}</password>
    </proxy>
  </proxies>
  <mirrors>
    <mirror>
      <id>example-mirror</id>
      <name>mirror</name>
    </mirror>
  </mirrors>
</settings>
