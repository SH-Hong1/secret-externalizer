# The web and worker images need only the Go module, the source they copy
# in, and the worker's scanner lock file and the script that reads it;
# everything else stays out of the build context.
*
!go.mod
!go.sum
!cmd/
!internal/
!deploy/worker/fetch-scanners.sh
!deploy/worker/scanners.lock
**/*_test.go
**/testdata/
