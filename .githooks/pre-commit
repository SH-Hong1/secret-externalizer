#!/bin/sh
# Formats the staged Go files, then runs make check. It does nothing when the
# commit touches nothing those checks look at.
set -eu

cd "$(git rev-parse --show-toplevel)"

# Deleted files count: removing a file can break code that still uses it.
staged=$(git diff --cached --name-only --diff-filter=ACMRD)
checked=$(printf '%s\n' "$staged" |
	grep -E '(\.go$|^go\.(mod|sum)$|^\.golangci\.yml$|^Makefile$|^rules/|^internal/web/(templates|assets|static)/|(^|/)testdata/|^\.githooks/|^scripts/|^deploy/.*\.sh$|^deploy/worker/scanners\.lock$)' || true)
[ -n "$checked" ] || exit 0

# make check reads the work tree, so it checks what is committed only when
# every checked file is staged as it is on disk. Formatting below also stages
# the Go files again, which would take in changes deliberately left out.
for f in $checked; do
	if ! git diff --quiet -- "$f" || { [ -e "$f" ] && ! git cat-file -e ":$f" 2>/dev/null; }; then
		printf 'pre-commit: %s has changes that are not staged; stage or stash them first\n' "$f" >&2
		exit 1
	fi
done

gofiles=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.go$' | grep -Ev '(^|/)testdata/' || true)
if [ -n "$gofiles" ]; then
	make -s "$(pwd)/bin/golangci-lint"
	# shellcheck disable=SC2086 # Go file paths have no spaces.
	bin/golangci-lint fmt $gofiles
	# shellcheck disable=SC2086
	git add -- $gofiles
fi

# git commit -a points GIT_INDEX_FILE at a temporary index for this hook.
# make check runs tests that use git in repositories of their own, which must
# not see the variables that locate this one.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_OBJECT_DIRECTORY GIT_PREFIX
make -s check
